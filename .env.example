# Local development uses platform identity headers only in a trusted test harness.
# Set the bootstrap admin USER ID with native Sites secrets before hosted use.
# KHESHT_BOOTSTRAP_ADMIN_USER_ID=
# Maintenance is disabled unless BOTH values below are configured by the owner.
# Enable only after verifying the Site audience contains its owner alone.
# KHESHT_MAINTENANCE_MODE=owner-private
# KHESHT_MAINTENANCE_HOST=your-exact-private-site.chatgpt.site
# Disable maintenance BEFORE changing the audience. Never put service tokens here.
# Shared-site service maintenance (configure through server secrets only):
# KHESHT_MAINTENANCE_MODE=signed-service
# KHESHT_MAINTENANCE_SIGNING_KEY=<at-least-32-random-characters>
# Keep a separate secure copy in the scheduler's secret vault, never its prompt.
# Runtime auth for standalone deployments is documented in README.md.
